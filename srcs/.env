# ---- Database settings (used by MariaDB + WordPress) ----
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
DB_HOST=mariadb
WP_TABLE_PREFIX=wp_

# ---- WordPress site metadata ----
WP_URL=https://localhost
WP_TITLE=Inception
WP_ADMIN_USER=wp_admin
WP_ADMIN_EMAIL=admin@example.com
WP_USER=wp_user
WP_USER_EMAIL=user@example.com

# ---- Nginx virtual host / cert CN ----
SERVER_NAME=fkarika.42.fr
